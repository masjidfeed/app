<?xml version="1.0" encoding="utf-8"?>
<!-- NFR-PR-01: Android permissions with minimum necessary access. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<queries>
		<intent>
			<action android:name="android.intent.action.VIEW" />
			<data android:scheme="geo" />
		</intent>
	</queries>
	<!-- NFR-SC-04: HTTPS-only in production; cleartext allowed only for local dev hosts (see xml/network_security_config). -->
	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:networkSecurityConfig="@xml/network_security_config">
		<meta-data android:name="com.google.android.geo.API_KEY" android:value="${googleMapsApiKey}" />
		<receiver android:name="com.google.firebase.iid.FirebaseInstanceIdInternalReceiver" android:exported="false" />
		<receiver android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver" android:exported="true" android:permission="com.google.android.c2dm.permission.SEND">
			<intent-filter>
				<action android:name="com.google.android.c2dm.intent.RECEIVE" />
				<action android:name="com.google.android.c2dm.intent.REGISTRATION" />
				<category android:name="${applicationId}" />
			</intent-filter>
		</receiver>
		<activity-alias android:name=".GenericLauncher" android:enabled="true" android:exported="true"
			android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round"
			android:targetActivity="com.goodsoftware.masjidapp.MainActivity">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>
		<!-- BEGIN GENERATED BRANDED LAUNCHER ALIASES -->
		<activity-alias android:name=".IcobLauncher" android:enabled="false" android:exported="true"
			android:icon="@mipmap/icob_appicon" android:roundIcon="@mipmap/icob_appicon"
			android:targetActivity="com.goodsoftware.masjidapp.MainActivity">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>
		<activity-alias android:name=".MapsLauncher" android:enabled="false" android:exported="true"
			android:icon="@mipmap/maps_appicon" android:roundIcon="@mipmap/maps_appicon"
			android:targetActivity="com.goodsoftware.masjidapp.MainActivity">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>
		<!-- END GENERATED BRANDED LAUNCHER ALIASES -->
		<!-- TC-04, FR-WG-01: Prayer Times home-screen App Widget. -->
		<receiver
			android:name="masjidapp.platforms.android.widget.PrayerTimesWidgetProvider"
			android:exported="true"
			android:label="Prayer Times Widget">
			<intent-filter>
				<action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
			</intent-filter>
			<meta-data
				android:name="android.appwidget.provider"
				android:resource="@xml/prayer_widget_info" />
		</receiver>
		<receiver
			android:name="masjidapp.platforms.android.widget.NextPrayerWidgetProvider"
			android:exported="true"
			android:label="Prayer Times">
			<intent-filter>
				<action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
			</intent-filter>
			<meta-data
				android:name="android.appwidget.provider"
				android:resource="@xml/next_prayer_widget_info" />
		</receiver>
	</application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Camera: for QR scanning when adding a masjid (FR-ST-06). Not required at install. -->
	<uses-permission android:name="android.permission.CAMERA" />
	<!-- Location: for Qibla calculation only (approximate), never background, never stored. -->
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<!-- Vibrate: optional for prayer reminder notifications. -->
	<uses-permission android:name="android.permission.VIBRATE" />
	<!-- POST_NOTIFICATIONS: required on Android 13+ for local prayer reminders. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!-- RECEIVE_BOOT_COMPLETED: lets the scheduled-alarm receiver restore pending prayer reminders after a reboot (FR-PN-07). -->
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
