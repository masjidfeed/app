<?xml version="1.0" encoding="utf-8"?>
<!-- FR-WG-01: compact next-prayer widget, matching the iOS medium widget shape. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_next_hijri_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFCC00"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_next_masjid_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="#D8FFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_next_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:max="1000"
        android:progress="0"
        android:progressTint="#FFCC00"
        android:progressBackgroundTint="#22FFFFFF" />

    <TextView
        android:id="@+id/widget_next_staleness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFCC00"
        android:textSize="11sp"
        android:maxLines="2"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Chronometer
            android:id="@+id/widget_next_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_next_countdown_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="#E0FFFFFF"
            android:textSize="20sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#55FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fajr" android:textColor="#C7FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_next_fajr_iqama" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_next_fajr_athan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#C7FFFFFF" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sunrise" android:textColor="#C7FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_next_sunrise_iqama" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_next_sunrise_athan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#C7FFFFFF" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dhuhr" android:textColor="#C7FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_next_dhuhr_iqama" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_next_dhuhr_athan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#C7FFFFFF" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Asr" android:textColor="#C7FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_next_asr_iqama" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_next_asr_athan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#C7FFFFFF" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Maghrib" android:textColor="#C7FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_next_maghrib_iqama" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_next_maghrib_athan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#C7FFFFFF" android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Isha" android:textColor="#C7FFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_next_isha_iqama" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_next_isha_athan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#C7FFFFFF" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>