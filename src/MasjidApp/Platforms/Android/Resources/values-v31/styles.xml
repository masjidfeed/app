<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ uses the platform splash API instead of windowBackground. -->
    <style name="Maui.SplashTheme" parent="Maui.MainTheme.NoActionBar">
        <item name="maui_splash">true</item>
        <item name="android:windowBackground">@drawable/maui_splash_screen</item>
        <item name="android:windowSplashScreenBackground">#FFFFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/system_status_bar_background</item>
        <item name="android:navigationBarColor">@color/system_navigation_bar_background</item>
        <item name="android:windowLightStatusBar">@bool/system_bar_light_appearance</item>
        <item name="android:windowLightNavigationBar">@bool/system_bar_light_appearance</item>
    </style>
</resources>
