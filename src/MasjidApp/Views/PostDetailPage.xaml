<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MasjidApp.Views.PostDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MasjidApp.Controls"
    xmlns:vm="clr-namespace:MasjidApp.ViewModels"
    xmlns:converters="clr-namespace:MasjidApp.Converters"
    xmlns:l="clr-namespace:MasjidApp.Localization"
    x:DataType="vm:PostDetailViewModel"
    Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="0,0,0,32"
            Spacing="0"
            IsVisible="{Binding Post, Converter={StaticResource IsNotNullConverter}}">

            <Image
                Source="{Binding Post.ImageUrl}"
                Aspect="AspectFit"
                IsVisible="{Binding Post.ImageUrl, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                SemanticProperties.Description="Post image">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding PreviewImageCommand}"
                        CommandParameter="{Binding Post.ImageUrl}" />
                </Image.GestureRecognizers>
            </Image>

            <VerticalStackLayout Padding="20,16" Spacing="12">
                <Label
                    Text="{Binding Post.Category}"
                    TextTransform="Uppercase"
                    Style="{StaticResource TextMicroStrong}"
                    CharacterSpacing="1"
                    TextColor="{DynamicResource ActivePrimaryColor}"
                    IsVisible="{Binding Post.Category, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                    SemanticProperties.Description="{Binding Post.Category, StringFormat='Category: {0}'}" />

                <Label
                    Text="{Binding Post.Title}"
                    FontFamily="GildaDisplay"
                    Style="{StaticResource TextHeadline}"
                    SemanticProperties.HeadingLevel="Level1"
                    SemanticProperties.Description="{Binding Post.Title}" />

                <Label
                    Text="↻ Recurring event"
                    Style="{StaticResource TextCaption}"
                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                    IsVisible="{Binding Post.RecurrenceRule, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                    SemanticProperties.Description="This is a recurring event" />

                <Border
                    Padding="14,12"
                    Stroke="{AppThemeBinding Light={StaticResource EventAlertBorder}, Dark={StaticResource EventAlertBorderDark}}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Background="{AppThemeBinding Light={StaticResource EventAlertBackground}, Dark={StaticResource EventAlertBackgroundDark}}"
                    IsVisible="{Binding HasActiveAlert}">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{l:Localize Events_Alert_Label}"
                            Style="{StaticResource TextCaptionStrong}"
                            TextTransform="Uppercase"
                            TextColor="{AppThemeBinding Light={StaticResource EventAlertText}, Dark={StaticResource EventAlertTextDark}}"
                            SemanticProperties.HeadingLevel="Level2" />
                        <Label
                            Text="{Binding ActiveAlert}"
                            Style="{StaticResource TextBody}"
                            LineBreakMode="WordWrap"
                            TextColor="{AppThemeBinding Light={StaticResource EventAlertText}, Dark={StaticResource EventAlertTextDark}}" />
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Spacing="8" IsVisible="{Binding HasEventDateTime}">
                    <Label
                        Text="📅"
                        Style="{StaticResource GlyphInline}"
                        VerticalOptions="Center"
                        AutomationProperties.IsInAccessibleTree="False" />
                    <Label
                        Text="{Binding DisplayEventDateTime, StringFormat='{0:dddd, MMMM d, yyyy · h:mm tt}'}"
                        Style="{StaticResource TextBody}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="{Binding DisplayEventDateTime, StringFormat='Date and time: {0:dddd, MMMM d, yyyy at h:mm tt}'}" />
                </HorizontalStackLayout>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Label
                            Text="{Binding Post.PublishedAt, StringFormat='{0:MMMM d, yyyy}'}"
                            Style="{StaticResource TextCaption}"
                            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                            VerticalOptions="Center"
                            IsVisible="{Binding IsAnnouncement}"
                            SemanticProperties.Description="{Binding Post.PublishedAt, StringFormat='Published {0:MMMM d, yyyy}'}" />
                        <HorizontalStackLayout
                            Spacing="8"
                            IsVisible="{Binding Post.Location, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                            <Label
                                Text="📍"
                                Style="{StaticResource GlyphInline}"
                                VerticalOptions="Center"
                                AutomationProperties.IsInAccessibleTree="False" />
                            <Label
                                Text="{Binding Post.Location}"
                                Style="{StaticResource TextBody}"
                                VerticalOptions="Center"
                                SemanticProperties.Description="{Binding Post.Location, StringFormat='Location: {0}'}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <HorizontalStackLayout
                        Grid.Column="1"
                        Spacing="4"
                        IsVisible="{Binding Post.Url, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                        <Border
                            WidthRequest="38"
                            HeightRequest="38"
                            Padding="5"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            AutomationId="PostDetailBrowseButton"
                            SemanticProperties.Description="{l:Localize PostActions_Browse}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BrowseCommand}" />
                            </Border.GestureRecognizers>
                            <Image
                                Source="post_browse.png"
                                WidthRequest="18"
                                HeightRequest="18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Aspect="AspectFit" />
                        </Border>
                        <Border
                            WidthRequest="38"
                            HeightRequest="38"
                            Padding="5"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            AutomationId="PostDetailShareButton"
                            SemanticProperties.Description="{l:Localize PostActions_Share}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShareCommand}" />
                            </Border.GestureRecognizers>
                            <Image
                                Source="share.png"
                                WidthRequest="18"
                                HeightRequest="18"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Aspect="AspectFit" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <BoxView
                    HeightRequest="1"
                    Margin="0,4"
                    Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                <controls:RichContentView
                    Html="{Binding Post.Description}"
                    IsVisible="{Binding Post.Description, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                    SemanticProperties.Description="Post content" />

                <Button
                    Margin="0,8"
                    Text="Add to Calendar"
                    Command="{Binding AddToCalendarCommand}"
                    IsVisible="{Binding HasEventDateTime}"
                    AutomationId="PostDetailAddToCalendarButton"
                    SemanticProperties.Description="Add this event to your device calendar" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
