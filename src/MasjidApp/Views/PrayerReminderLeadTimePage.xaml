<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MasjidApp.Views.PrayerReminderLeadTimePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MasjidApp.ViewModels"
    x:DataType="vm:PrayerReminderLeadTimeViewModel"
    Title="{Binding Title}"
    Background="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource OffBlack}}">

    <Grid Padding="16,24" RowDefinitions="Auto,Auto">
        <Border
            Padding="0"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 8"
            Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
            VerticalOptions="Start">
            <VerticalStackLayout
                Spacing="0"
                IsEnabled="{Binding CanSelectLeadTime}"
                BindableLayout.ItemsSource="{Binding Options}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:PrayerReminderLeadTimeOption">
                        <VerticalStackLayout Spacing="0">
                            <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PrayerReminderLeadTimeViewModel}}, Path=SelectLeadTimeCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label
                                    Text="{Binding DisplayName}"
                                    Style="{StaticResource TextSubhead}"
                                    VerticalOptions="Center"
                                    SemanticProperties.Description="{Binding DisplayName}" />
                                <Label
                                    Grid.Column="1"
                                    Text="✓"
                                    Style="{StaticResource GlyphSelected}"
                                    TextColor="{DynamicResource ActivePrimaryColor}"
                                    IsVisible="{Binding IsSelected}" />
                            </Grid>
                            <BoxView
                                HeightRequest="1"
                                Margin="16,0,0,0"
                                IsVisible="{Binding ShowSeparator}"
                                Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>

        <Label
            Grid.Row="1"
            Margin="0,12,0,0"
            Text="{Binding Status}"
            IsVisible="{Binding Status, Converter={StaticResource IsNotNullOrEmptyConverter}}"
            Style="{StaticResource TextCaption}"
            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
            SemanticProperties.Description="{Binding Status}" />
    </Grid>
</ContentPage>