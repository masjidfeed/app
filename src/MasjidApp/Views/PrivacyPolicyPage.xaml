<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MasjidApp.Views.PrivacyPolicyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:l="clr-namespace:MasjidApp.Localization"
    Title="{l:Localize Privacy_Title}">

    <!-- NFR-PR-02: privacy policy reachable from the app (App Store / Play compliance). -->
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="{l:Localize Privacy_Title}"
                Style="{StaticResource TextTitle}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="{l:Localize Privacy_Summary}"
                Style="{StaticResource TextBody}"
                LineBreakMode="WordWrap" />

            <Label
                Text="{l:Localize Privacy_Contact}"
                Style="{StaticResource TextBody}"
                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                LineBreakMode="WordWrap" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
