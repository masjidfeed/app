<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MasjidApp.Views.AddMasjidPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MasjidApp.ViewModels"
    xmlns:l="clr-namespace:MasjidApp.Localization"
    x:DataType="vm:AddMasjidViewModel"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="{l:Localize AddMasjid_UrlLabel}"
                Style="{StaticResource TextSubhead}"
                SemanticProperties.HeadingLevel="Level2" />

            <Label
                Text="{l:Localize AddMasjid_UrlSubtitle}"
                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

            <!-- URL entry -->
            <Entry
                Placeholder="{l:Localize AddMasjid_UrlHint}"
                Text="{Binding Url}"
                Keyboard="Url"
                IsEnabled="{Binding IsValidating, Converter={StaticResource InvertBoolConverter}}"
                AutomationId="MasjidUrlEntry"
                SemanticProperties.Description="Masjid URL input" />

            <!-- Add by URL button -->
            <Button
                Text="{l:Localize AddMasjid_Connect_Button}"
                Command="{Binding AddByUrlCommand}"
                IsEnabled="{Binding IsValidating, Converter={StaticResource InvertBoolConverter}}"
                AutomationId="ConnectButton"
                SemanticProperties.Description="Connect to this masjid URL" />

            <!-- Busy indicator -->
            <ActivityIndicator
                IsRunning="{Binding IsValidating}"
                IsVisible="{Binding IsValidating}"
                HorizontalOptions="Center" />

            <!-- Status feedback -->
            <Label
                Text="{Binding StatusMessage}"
                IsVisible="{Binding StatusMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                SemanticProperties.Description="{Binding StatusMessage}" />

            <BoxView
                HeightRequest="1"
                Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                Margin="0,8" />

            <Label
                Text="{l:Localize AddMasjid_ScanQr_Title}"
                Style="{StaticResource TextSubheadStrong}"
                SemanticProperties.HeadingLevel="Level2" />

            <Label
                Text="{l:Localize AddMasjid_ScanQr_Subtitle}"
                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

            <!-- Placeholder for QR scanner (wired up in code-behind when camera permission granted) -->
            <Button
                x:Name="ScanQrButton"
                Text="{l:Localize AddMasjid_ScanQr_Button}"
                Clicked="OnScanQrClicked"
                AutomationId="ScanQrButton"
                SemanticProperties.Description="Open camera to scan QR code" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
