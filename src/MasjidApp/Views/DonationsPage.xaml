<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MasjidApp.Views.DonationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MasjidApp.Controls"
    xmlns:l="clr-namespace:MasjidApp.Localization"
    xmlns:vm="clr-namespace:MasjidApp.ViewModels"
    x:DataType="vm:DonationsViewModel"
    Title="{l:Localize Donations_Title}">

    <!-- FR-DN-01–FR-DN-04, NFR-SC-03: the masjid page renders inline, while
         third-party HTTPS destinations open in the system-preferred browser. -->

    <Grid SafeAreaEdges="Container,Container,Container,None">
        <Grid SafeAreaEdges="None">
            <controls:DonationWebView
                x:Name="DonationWebView"
                Source="{Binding DonationUrl}"
                IsVisible="{Binding HasDonationUrl}"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                Navigating="OnDonationWebViewNavigating"
                Navigated="OnDonationWebViewNavigated"
                ProcessTerminated="OnDonationWebViewProcessTerminated" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <ActivityIndicator
                x:Name="DonationLoadingIndicator"
                IsRunning="False"
                IsVisible="False"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                SemanticProperties.Description="{l:Localize App_Loading}" />

            <Label
                Margin="24"
                Text="{l:Localize Donations_NoUrl}"
                Style="{StaticResource TextBody}"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center"
                IsVisible="{Binding ShowNoDonationUrl}"
                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                SemanticProperties.Description="{l:Localize Donations_NoUrl}" />

            <Border
                x:Name="DonationErrorPanel"
                Margin="24"
                Padding="20"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                IsVisible="False">
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="{l:Localize Donations_LoadError}"
                        Style="{StaticResource TextBody}"
                        HorizontalTextAlignment="Center"
                        SemanticProperties.Description="{l:Localize Donations_LoadError}" />
                    <Button
                        Text="{l:Localize App_Retry}"
                        Clicked="OnRetryClicked"
                        Style="{StaticResource ButtonCompact}"
                        HorizontalOptions="Center" />
                    <Button
                        Text="{l:Localize Donations_OpenBrowser_Button}"
                        Command="{Binding OpenDonationsCommand}"
                        Style="{StaticResource ButtonCompact}"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
