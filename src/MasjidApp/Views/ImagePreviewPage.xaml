<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MasjidApp.Views.ImagePreviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:l="clr-namespace:MasjidApp.Localization"
    BackgroundColor="Transparent"
    SafeAreaEdges="None"
    ios:Page.ModalPresentationStyle="OverFullScreen">

    <Grid BackgroundColor="#B3000000" SafeAreaEdges="None">
        <Grid Padding="12" SafeAreaEdges="Container">
            <Grid x:Name="PhotoViewport" Margin="0,52" IsClippedToBounds="True">
                <Grid.GestureRecognizers>
                    <PinchGestureRecognizer PinchUpdated="OnPhotoPinchUpdated" />
                    <PanGestureRecognizer PanUpdated="OnPhotoPanUpdated" />
                </Grid.GestureRecognizers>
                <Image
                    x:Name="PreviewImage"
                    AutomationId="ImagePreviewPhoto"
                    Aspect="AspectFit"
                    SemanticProperties.Description="Full-screen image preview" />
            </Grid>

            <Button
                x:Name="CloseButton"
                AutomationId="ImagePreviewCloseButton"
                Text="×"
                TextColor="White"
                BackgroundColor="#303030"
                FontSize="26"
                FontAutoScalingEnabled="False"
                Padding="0"
                WidthRequest="44"
                HeightRequest="44"
                CornerRadius="22"
                HorizontalOptions="End"
                VerticalOptions="Start"
                SemanticProperties.Description="{l:Localize App_Close}"
                Clicked="OnCloseClicked" />
        </Grid>
    </Grid>

</ContentPage>
