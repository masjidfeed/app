<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MasjidApp.Controls.MapControlButton"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MasjidApp.Controls"
    x:DataType="controls:MapControlButton">

    <Border
        WidthRequest="44"
        HeightRequest="44"
        Padding="0"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 22"
        BackgroundColor="#2C2C2E"
        HorizontalOptions="Center"
        SemanticProperties.Description="{Binding SemanticDescription, Source={x:Reference Root}}">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.3" Radius="6" Offset="0,2" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>

        <Grid>
            <Image
                x:Name="GlyphImage"
                WidthRequest="20"
                HeightRequest="20"
                HorizontalOptions="Center"
                VerticalOptions="Center" />
            <Label
                x:Name="BadgeLabel"
                Text="{Binding Badge, Source={x:Reference Root}}"
                Style="{StaticResource TextMicroStrong}"
                FontSize="10"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,3,0,0"
                IsVisible="{Binding Badge, Source={x:Reference Root}, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
        </Grid>
    </Border>
</ContentView>
